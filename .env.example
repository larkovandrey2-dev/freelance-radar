POSTGRES_DB=lead_radar
POSTGRES_USER=lead_radar
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

APP_HOST=0.0.0.0
APP_PORT=8000
# Host-only port. Change this if another local service already occupies 8000.
HOST_PORT=8000
LOG_LEVEL=INFO

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_TRANSPORT=direct
TELEGRAM_BOT_TRANSPORT=proxy
TELEGRAM_PROXY_URL=socks5h://host.docker.internal:10808
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=host.docker.internal
TELEGRAM_PROXY_PORT=10808
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional: defaults to gpt://<YANDEX_FOLDER_ID>/qwen3.6-35b-a3b.
YANDEX_MODEL_URI=
# Existing OpenAI-compatible setup is supported too:
# YANDEX_CLOUD_API_KEY=
# YANDEX_OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# YANDEX_CHAT_MODEL_URI=gpt://<folder_id>/qwen3.6-35b-a3b/latest
YANDEX_TRANSPORT=direct
LEAD_ALERT_THRESHOLD=72
# Do not alert on historical messages imported during collector startup.
MAX_ALERT_AGE_HOURS=24
REJECTED_AUDIT_RATE=0.01
REJECTED_AUDIT_DAILY_LIMIT=15

## Personal Discord account token; collector is strictly read-only and only
## listens to channels explicitly listed in config/sources.yaml.
DISCORD_USER_TOKEN=
DISCORD_TRANSPORT=direct
FORUM_TRANSPORT=direct
FORUM_POLL_MIN_SECONDS=45
FORUM_POLL_MAX_SECONDS=90
REDDIT_TRANSPORT=direct
REDDIT_POLL_MIN_SECONDS=60
REDDIT_POLL_MAX_SECONDS=120
X_TRANSPORT=direct

# Deterministic pricing floors used by the on-demand offer generator.
PRICING_FLOOR_MICRO=50
PRICING_FLOOR_SMALL=100
PRICING_FLOOR_MEDIUM=300
PRICING_FLOOR_LARGE=800

EXTERNAL_PROXY=
BYEDPI_PROXY=socks5://byedpi:1080
# Example listener configuration for the sidecar; tune for your network.
BYEDPI_ARGS=--port 1080
BACKFILL_LIMIT=30

# Generic local ingestion gateway (disabled until AUTH_SECRET_KEY is set).
AUTH_SECRET_KEY=
MY_INTERNAL_ID=
LOCAL_GATEWAY_HOST=0.0.0.0
LOCAL_GATEWAY_PORT=8765
LOCAL_GATEWAY_CLIENT_HOST=127.0.0.1
LOCAL_GATEWAY_SQLITE_PATH=/data/gateway/seen_messages.sqlite3
